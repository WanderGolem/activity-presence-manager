{
  "name": "activity-presence-manager",
  "version": "1.4.0",
  "description": "Desktop app for managing Discord Rich Presence",
  "main": "main.js",
  "productName": "Activity Presence Manager",
  "author": "WanderGolem",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/WanderGolem/activity-presence-manager.git"
  },
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --win --dir",
    "dist": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always"
  },
  "dependencies": {
    "discord-rpc": "^4.0.1",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.3",
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "electron": "^40.8.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.wandergolem.activitypresencemanager",
    "productName": "Activity Presence Manager",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!.npm-cache/**",
      "!.codex/**",
      "!.github/**",
      "!.git/**",
      "!.gitignore",
      "!.gitattributes",
      "!.env*",
      "!README.md"
    ],
    "extraResources": [
      {
        "from": "languages",
        "to": "languages"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Activity Presence Manager",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "WanderGolem",
        "repo": "activity-presence-manager"
      }
    ]
  }
}
